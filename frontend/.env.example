# Backend API base URL. Defaults to http://127.0.0.1:8000 locally, or the
# deployed Render backend when served from a netlify.app hostname.
VITE_API_BASE=http://127.0.0.1:8000

# Stellar Horizon endpoint used for balance lookups and tx building.
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase must match VITE_HORIZON_URL's network.
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Informational label surfaced by /contract/info.
VITE_STELLAR_NETWORK=TESTNET

# ─────────────────────────────────────────────
# A2A Protocol — Environment Variables Template
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────

# ── Stellar Network ──────────────────────────
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_STELLAR_NETWORK=TESTNET

# ── Contract Addresses ───────────────────────
# CONTRACT_MODE=onchain enables backend/routes/contract.py's real
# InvokeHostFunction calls against the escrow contract below (default is
# "legacy", which builds plain payment ops instead - see
# docs/CONTRACT_DEPLOYMENT.md). ESCROW_TOKEN_ID is the asset a deal escrows
# by default when CONTRACT_MODE=onchain; the value here is the testnet
# native XLM SAC, not a custom protocol token - the A2AT design discussed
# in the README/whitepaper is proposed, not implemented, and has no env
# var or code path here.
CONTRACT_MODE=legacy
ESCROW_CONTRACT_ID=CBCG25INND2P3BVBBRT44XJHSGDKAMUNEAVWUMI7J2TCIBMJVBNIZ2NU
ESCROW_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# ── Wallet Config ─────────────────────────────
# Default seller wallet used when none is supplied in the deal request
DEFAULT_SELLER_WALLET=GC5OZM7AY73DKZMPWU5BMW3EA6BXCYJIIF6UUQQ44XT4DOJQOXQZU2YF

# ── AI / LLM ─────────────────────────────────
# Required for negotiation engine — obtain from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative variable name accepted by the backend
GOOGLE_API_KEY=

# ── Backend ───────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# ── x402 Payment Mode ────────────────────────
# "simulate" (default) — all payment gates pass automatically (safe for demos)
# "enforce"            — requires real on-chain Stellar payment for gated actions
X402_MODE=simulate

# ── x402 Fee Schedule (XLM) ──────────────────
X402_ESCROW_FEE=0.01
X402_RELEASE_FEE=0.01
X402_COMPLETION_FEE=0.01
X402_AUDIT_FEE=0.01

# ── On-chain State Verification ──────────────
# When "true" (default), /deal/{id}/fund, /deal/{id}/onchain-accept, and
# /deal/{id}/release all verify the supplied txid against Horizon before
# trusting it. Only set to "false" for local/offline development -
# must stay "true" in every deployed environment, especially mainnet.
VERIFY_ONCHAIN_TX=true

# ── Mainnet checklist ─────────────────────────
# Before pointing this app at Stellar Mainnet, see docs/MAINNET_AUDIT.md.
# At minimum: X402_MODE=enforce, VERIFY_ONCHAIN_TX=true, CORS_ORIGINS set
# to your real frontend origin (never "*"), and DEFAULT_SELLER_WALLET
# either unset or a reviewed real address (it is only ever a fallback).

# ─────────────────────────────────────────────
# A2A Protocol — Environment Variables Template
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────

# ── Stellar Network ──────────────────────────
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_STELLAR_NETWORK=TESTNET

# ── Contract Addresses ───────────────────────
ESCROW_CONTRACT_ID=CDKOZ25IENHQFRRNTJDXAYAOUSDBPUXLE52UGTNIPWACAMGAMNXMYTQU
TOKEN_CONTRACT_ID=CB5YMKKIGH7UFLWDNZRH5P5ENXE7VQIOJSA2FDVQQB3Z7AEUIFQOEFTI

# ── Wallet Config ─────────────────────────────
# Default seller wallet used when none is supplied in the deal request
DEFAULT_SELLER_WALLET=GC5OZM7AY73DKZMPWU5BMW3EA6BXCYJIIF6UUQQ44XT4DOJQOXQZU2YF

# ── AI / LLM ─────────────────────────────────
# Required for negotiation engine — obtain from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative variable name accepted by the backend
GOOGLE_API_KEY=

# ── Backend ───────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# ── x402 Payment Mode ────────────────────────
# "simulate" (default) — all payment gates pass automatically (safe for demos)
# "enforce"            — requires real on-chain Stellar payment for gated actions
X402_MODE=simulate

# ── x402 Fee Schedule (XLM) ──────────────────
X402_ESCROW_FEE=0.01
X402_RELEASE_FEE=0.01
X402_COMPLETION_FEE=0.01
X402_AUDIT_FEE=0.01
